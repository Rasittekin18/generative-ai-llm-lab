# LLM Sağlayıcı Ayarları (Ollama, Groq, OpenAI veya Hugging Face Router)
# Örnek 1 (Ücretsiz Yerel Ollama):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct
#   LLM_API_KEY=ollama
#
# Örnek 2 (Groq - Çok Hızlı):
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_API_KEY=gsk_...
#
# Örnek 3 (Hugging Face Inference Router):
#   LLM_PROVIDER=huggingface
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   LLM_API_KEY=hf_...

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=

# Yerel Hugging Face Sınıflandırma & NER Modelleri (Bölüm 2 & 3)
LOCAL_HF_ENABLED=true
HF_CONTEXT_MODEL=typeform/distilbert-base-uncased-mnli
HF_NER_MODEL=dslim/bert-base-NER

# Masaüstü Tetikleyicileri
ENABLE_MOUSE_SELECTION_POPUP=true
HOTKEY_TRANSLATE=<alt>+q
HOTKEY_WRITER=<alt>+w

# Sunucu
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
