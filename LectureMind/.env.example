# LectureMind Yapılandırması (.env olarak kopyalayıp isteğe göre düzenleyebilirsiniz)

# Whisper Ayarları (tiny, base, small, medium, large-v3-turbo)
LECTUREMIND_WHISPER_MODEL=small
LECTUREMIND_WHISPER_DEVICE=auto

# Çok Dilli Semantik Arama Modeli (Türkçe + İngilizce)
LECTUREMIND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# İsteğe Bağlı LLM Sentezleyici (Varsayılan: local -> API anahtarı olmadan tamamen yerel çalışır)
# Seçenekler: local | ollama | openai | gemini
LECTUREMIND_LLM_PROVIDER=local

# Ollama kullanılacaksa:
LECTUREMIND_OLLAMA_BASE_URL=http://localhost:11434
LECTUREMIND_OLLAMA_MODEL=qwen2.5:3b

# OpenAI kullanılacaksa:
# LECTUREMIND_OPENAI_API_KEY=sk-...
# LECTUREMIND_OPENAI_MODEL=gpt-4o-mini

# Gemini kullanılacaksa:
# LECTUREMIND_GEMINI_API_KEY=...
# LECTUREMIND_GEMINI_MODEL=gemini-2.5-flash
