# Sunucu & Depolama
APP_HOST=127.0.0.1
APP_PORT=8000

# Model Sağlayıcıları (ollama | gemini | openai)
LLM_PROVIDER=ollama
VLM_PROVIDER=auto

# Yerel Ollama Ayarları (GTX 1650 / Yerel ortam)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_VLM_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SEC=120

# Yerel Embedding Modeli (Hugging Face - Yerel önbellekten yüklenir)
EMBEDDING_MODEL=emrecan/bert-base-turkish-cased-mean-nli-stsb-tr

# Opsiyonel Bulut API Anahtarları (Kullanılmak istenirse)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
