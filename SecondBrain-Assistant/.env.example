# Google AI Studio (Ücretsiz Katman): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kullanılacak ücretsiz Gemini modeli (örn. gemini-3-flash-preview veya gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3-flash-preview

# Telegram Bot (Opsiyonel - Ücretsiz): Telegram'da @BotFather üzerinden /newbot ile alınır
TELEGRAM_BOT_TOKEN=

# Güvenlik (Opsiyonel): Botu sadece kendi Telegram ID'nize kısıtlamak için virgülle ayırın
# Örn: 123456789,987654321 (Boş bırakılırsa herkese açıktır)
TELEGRAM_ALLOWED_USER_IDS=

# Obsidian Vault klasörünüzün yolunu buraya yazabilirsiniz; varsayılan olarak proje içi ./notes kullanılır
NOTES_DIR=./notes

# Sunucu ayarları
HOST=127.0.0.1
PORT=8090
