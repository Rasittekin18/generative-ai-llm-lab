# === GÜVENLİK AYARLARI ===
# Kendi telefon numaran (ülke kodu ile, başında + veya 0 olmadan; örn: 905551234567)
# Boş bırakırsan QR okuttuğun hesabın yalnızca KENDİ sohbeti (Kendime Mesaj) kabul edilir.
ALLOWED_PHONE=

# Yerel MCP <-> WhatsApp Köprüsü HTTP API ayarları (yalnızca 127.0.0.1 dinler)
BRIDGE_API_PORT=3847
BRIDGE_API_TOKEN=degistir-guclu-rastgele-bir-token-yaz

# === YAPAY ZEKA AJANI (!agy) AYARLARI ===
# "auto" (önce Antigravity SDK dener, yoksa Gemini API'ye düşer) | "antigravity" | "gemini"
AGENT_BACKEND=auto

# Ajanın varsayılan çalışma klasörü (boş bırakılırsa bu proje klasörü kullanılır)
AGENT_WORKSPACE=

# Gemini ücretsiz API anahtarı (Google AI Studio: https://aistudio.google.com/apikey)
# AGENT_BACKEND=gemini veya auto fallback için isteğe bağlıdır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === DOSYA ARAMA & EKRAN GÖRÜNTÜSÜ ===
# Virgülle ayrılmış ekstra arama klasörleri (boşsa Masaüstü, Belgeler, İndirilenler taranır)
SEARCH_DIRS=
SCREENSHOT_DIR=captures
